---
import { getCollection, render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import Arrow from '../../components/Arrow.astro';
import Architecture from '../../components/Architecture.astro';
export async function getStaticPaths() {
  return (await getCollection('projects')).map(project => ({ params: { slug: project.id }, props: { project } }));
}
interface Props { project: CollectionEntry<'projects'>; }
const { project } = Astro.props;
const { data } = project;
const { Content, headings } = await render(project);
const all = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const next = all[(all.findIndex(item => item.id === project.id) + 1) % all.length];
const base = import.meta.env.BASE_URL;
---
<Layout title={`${data.title} — Benny Ngo`} description={data.summary}>
  <article class="case-study container">
    <header class="case-header"><a class="text-link back-link" href={`${base}#work`}><span aria-hidden="true">←</span> Selected work</a><p class="eyebrow mono">{data.category} / CASE STUDY</p><h1>{data.title}<span class="accent">.</span></h1><p class="case-lead">{data.summary}</p><div class="case-meta"><span class="mono">{data.period}</span><span>{data.sourceVisibility === 'private' ? 'Source private' : 'Public repository'}</span><ul class="tags" aria-label="Technologies">{data.technologies.map(tag => <li>{tag}</li>)}</ul></div><div class="case-actions">{data.repositoryUrl && <a class="button button-primary" href={data.repositoryUrl} target="_blank" rel="noopener noreferrer">View source <Arrow diagonal /></a>}{data.demoUrl && <a class="button button-secondary" href={data.demoUrl} target="_blank" rel="noopener noreferrer">Live demo <Arrow diagonal /></a>}</div></header>
    <figure class="case-screenshot"><Image src={data.thumbnail} alt={data.thumbnailAlt} widths={[480, 800, 1160]} sizes="(max-width: 1160px) 100vw, 1160px" format="webp" quality={90} loading="eager" /><figcaption>{data.caption}</figcaption></figure>
    <div class="case-highlights">{data.highlights.map(item => <div><strong>{item.value}</strong><span>{item.label}</span></div>)}</div>
    <Architecture steps={data.architecture} />
    <div class="case-body"><aside class="case-toc"><p class="eyebrow mono">IN THIS CASE STUDY</p><nav aria-label="Case study sections">{headings.filter(h => h.depth === 2).map(h => <a href={`#${h.slug}`}>{h.text}</a>)}</nav></aside><div class="prose"><Content /></div></div>
    <a class="next-project" href={`${base}projects/${next.id}/`}><span><span class="eyebrow mono">NEXT PROJECT</span><strong>{next.data.title}</strong></span><Arrow diagonal /></a>
  </article>
</Layout>
