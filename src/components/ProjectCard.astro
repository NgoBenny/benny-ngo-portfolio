---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import Arrow from './Arrow.astro';
interface Props { project: CollectionEntry<'projects'>; featured?: boolean; }
const { project, featured = false } = Astro.props;
const { data } = project;
const href = `${import.meta.env.BASE_URL}projects/${project.id}/`;
---
<article class:list={['project-card', { 'project-featured': featured }]}>
  <a class="project-image" href={href} tabindex="-1" aria-hidden="true">
    <div class="image-toolbar"><span class="window-dots"><i></i><i></i><i></i></span><span>{data.subtitle}</span><span class="toolbar-status">PROJECT PREVIEW</span></div>
    <Image src={data.thumbnail} alt={data.thumbnailAlt} widths={featured ? [480, 760, 1160] : [360, 580, 760, 1160]} sizes={featured ? '(max-width: 760px) calc(100vw - 72px), (max-width: 1050px) 50vw, 567px' : '(max-width: 760px) calc(100vw - 68px), 532px'} format="webp" quality={90} loading="lazy" />
  </a>
  <div class="project-copy">
    <div class="project-eyebrow mono"><span>{String(data.order).padStart(2, '0')} / {data.category}</span><span>{data.sourceVisibility === 'private' ? 'Source private' : 'Open source'}</span></div>
    <h3><a href={href}>{data.title}<Arrow diagonal /></a></h3>
    <p>{data.summary}</p>
    <ul class="tags" aria-label="Technologies">{data.technologies.map(tag => <li>{tag}</li>)}</ul>
    {featured && <div class="project-stats">{data.highlights.map(item => <div><strong>{item.value}</strong><span>{item.label}</span></div>)}</div>}
    <a class="text-link" href={href}>Explore the case study <Arrow /></a>
  </div>
</article>
