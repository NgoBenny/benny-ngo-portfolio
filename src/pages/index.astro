---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import portrait from '../assets/benny-ngo.png';
import Layout from '../layouts/Layout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import Arrow from '../components/Arrow.astro';
import { profile } from '../data/profile';
const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const base = import.meta.env.BASE_URL;
---
<Layout>
  <section class="hero container" aria-labelledby="hero-title">
    <div class="hero-top mono"><span><span class="status-dot"></span> OPEN TO INTERNSHIPS</span><span>SANTA CLARA, CA · GEORGIA TECH</span></div>
    <div class="hero-main">
      <div><p class="hero-intro">Hi, I’m Benny.</p><h1 id="hero-title">Building useful<br class="desktop-break" /> software, <span class="soft">from<br class="desktop-break" /> data to interface.</span></h1></div>
      <div class="hero-aside"><span class="aside-mark" aria-hidden="true">↳</span><p>{profile.introduction}</p><div class="hero-actions"><a class="button button-primary" href="#work">View work <Arrow /></a><a class="button button-secondary" href={`${base}resume.pdf`}>Resume <Arrow diagonal /></a></div></div>
    </div>
    <div class="hero-bottom"><span>Software engineering <span class="accent">/</span> Applied AI <span class="accent">/</span> Full-stack development</span><a href="#work" class="scroll-link mono">SCROLL TO EXPLORE <span aria-hidden="true">↓</span></a></div>
  </section>
  <section id="work" class="work-section container" aria-labelledby="work-title">
    <div class="section-heading"><div><p class="eyebrow mono">01 / SELECTED WORK</p><h2 id="work-title">Projects I’ve built<span class="accent">.</span></h2></div><p>Sports prediction dashboards<br/>and a community web app.</p></div>
    <ProjectCard project={projects[0]} featured />
    <div class="project-grid">{projects.slice(1).map(project => <ProjectCard project={project} />)}</div>
  </section>
  <section id="about" class="about-section container" aria-labelledby="about-title">
    <div class="about-intro"><div><p class="eyebrow mono">02 / A LITTLE ABOUT ME</p><h2 id="about-title">A little about<br/><span class="soft">my background.</span></h2><p class="personal-note"><span aria-hidden="true">✳</span> I’m also an Eagle Scout and have taught Python.</p></div><div class="about-prose"><Image class="about-portrait" src={portrait} alt="Benny Ngo" widths={[160, 320, 480]} sizes="160px" format="webp" quality={90} loading="lazy" />{profile.about.map(paragraph => <p>{paragraph}</p>)}</div></div>
    <div class="background-grid"><div><h3 class="eyebrow mono">EDUCATION</h3>{profile.education.map(item => <article class="background-item"><span class="date mono">{item.date}</span><h4>{item.institution}</h4><p>{item.qualification}</p></article>)}</div><div><h3 class="eyebrow mono">EXPERIENCE</h3>{profile.experience.map(item => <article class="background-item"><span class="date mono">{item.date}</span><h4>{item.role}</h4><p class="organization">{item.organization}</p><p>{item.description}</p></article>)}</div></div>
  </section>
  <section id="skills" class="skills-section container" aria-labelledby="skills-title"><div class="section-heading"><div><p class="eyebrow mono">03 / MY TOOLKIT</p><h2 id="skills-title">What I work with<span class="accent">.</span></h2></div><p>Tools I’ve used in coursework<br/>and personal projects.</p></div><div class="skills-grid">{profile.skills.map((group, index) => <article><span class="skill-number mono">0{index + 1}</span><h3>{group.title}</h3><ul>{group.items.map(item => <li>{item}</li>)}</ul></article>)}</div></section>
  <section id="contact" class="contact-section container" aria-labelledby="contact-title"><div><p class="eyebrow mono">04 / CONTACT</p><h2 id="contact-title">Get in<br/><span class="soft">touch.</span></h2><p>I’m looking for software engineering and AI/ML internships.<br/>If you’re hiring or want to talk about a project, send me an email.</p><a class="contact-email" href={`mailto:${profile.email}`}>{profile.email} <Arrow diagonal /></a></div><div class="contact-links"><a href={profile.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn <Arrow diagonal /></a><a href={profile.github} target="_blank" rel="noopener noreferrer">GitHub <Arrow diagonal /></a><a href={`${base}resume.pdf`}>View resume <Arrow diagonal /></a></div></section>
</Layout>
